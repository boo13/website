#!/bin/sh

set -eu

# Agents read AGENTS.md directly; a CLAUDE.md would stop Claude Code from reading it.
FAILED=0

for FILE in CLAUDE.md GEMINI.md; do
  if [ -e "$FILE" ] || [ -L "$FILE" ]; then
    echo "pre-commit: remove $FILE; agents read AGENTS.md directly." >&2
    FAILED=1
  fi
done

if [ "$FAILED" -ne 0 ]; then
  echo "pre-commit: fix with: git rm -f CLAUDE.md GEMINI.md" >&2
  exit 1
fi
